# .vscodeignore — what `vsce package` leaves OUT of the .vsix.
# The .vsix ships five files: dist/extension.js, package.json, README.md, CHANGELOG.md and
# LICENSE (plan §11.3; `npx vsce ls --no-dependencies` lists them). Sources, tests, tooling and
# node_modules stay behind.
.vscode/**
.vscode-test/**
.vscode-test.mjs
.github/**
src/**
test/**
docs/**
scripts/**
out/**
coverage/**
node_modules/**
**/*.map
# `npm run analyze` leaves its raw metafile next to the bundle; it is a report, not code.
dist/meta.json
**/*.ts
esbuild.mjs
eslint.config.mjs
vitest.config.mts
tsconfig*.json
.gitignore
pr-cascade-plan.md
**/*.vsix
# Claude Code skill definitions (.claude/skills/**): tooling for the agent, not for users.
.claude/**
